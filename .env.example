# 16文字以上のランダムな値（Studioへのログインに使用）
HIGSGEN_API_KEY=replace-with-a-long-random-key

# Claude CodeをAPI課金で実行するAnthropic APIキー
ANTHROPIC_API_KEY=sk-ant-replace-me

HIGSGEN_PORT=4649

# HTTPSリバースプロキシ配下ではtrueにする
HIGSGEN_SECURE_COOKIE=false

# Higgsfield MCPを設定済みのClaude設定ディレクトリ
# CLAUDE_CONFIG_DIR=/absolute/path/to/.claude
